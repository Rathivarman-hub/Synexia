# ─────────────────────────────────────────────────────────────────────────────
# SYNTEXIA · Server environment
# Copy to `.env` and fill in. NEVER commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Client origins allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# ─── Core ─────────────────────────────────────────────────────────────────────
# ⚠️  JWT_SECRET must be a long random string. A publicly known value (e.g. the
#     jwt.io example "your-256-bit-secret") lets anyone mint an admin token.
#     Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-48-bytes-of-random-hex
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Without Redis the platform still runs; caching and distributed rate limiting
# are simply disabled.
REDIS_URL=rediss://default:<password>@<host>:<port>

# ─────────────────────────────────────────────────────────────────────────────
# CODING MODULE · CODE EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
# Judge0 CE public endpoint does not require RapidAPI credentials.
CODE_EXECUTION_PROVIDER=judge0
JUDGE0_API_URL=https://ce.judge0.com
# Optional RapidAPI/self-hosted authentication headers. Leave unset for CE.
# JUDGE0_API_KEY=
# JUDGE0_HOST=

# Optional fallback provider configuration (self-hosted Piston recommended).
PISTON_API_URL=http://localhost:2000/api/v2

# ── Limits ────────────────────────────────────────────────────────────────────
# Per-test-case execution budget in ms. Sent to the provider as the CPU/wall
# limit. Keep it generous enough to compile Java/C#/Go on a cold sandbox.
CODE_TIME_LIMIT_MS=5000
CODE_MEMORY_LIMIT_BYTES=134217728
# HTTP timeout for the provider call itself (must exceed CODE_TIME_LIMIT_MS to
# allow for the compile stage plus network latency).
CODE_EXEC_TIMEOUT_MS=30000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
